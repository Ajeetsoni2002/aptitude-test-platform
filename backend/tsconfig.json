{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    // Adhoora Google-login feature (abhi kahin import nahi hota) — build se bahar
    "src/migrations",
    "src/utils/authUtils.ts",
    "src/utils/authValidation.ts",
    "src/utils/serializeUser.ts"
  ]
}
