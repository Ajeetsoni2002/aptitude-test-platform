PORT=5000
NODE_ENV=development

# MongoDB Atlas (free M0 cluster) connection string
MONGO_URI=mongodb://localhost:27017/aptitude-test-platform

# Lamba random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL(s), comma separated, bina trailing slash ke
CLIENT_URL=http://localhost:5173

# Google Gemini API key (free tier: https://aistudio.google.com/apikey) — AI assistant ke liye
GEMINI_API_KEY=
# Optional: model override
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary (free tier) — question/profile images ke liye.
# Render free tier ki disk ephemeral hai, isliye production me ye ZAROORI hai.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: per-IP requests per 15 min (default 500)
RATE_LIMIT_MAX=500
