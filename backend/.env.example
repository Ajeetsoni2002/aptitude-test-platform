# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/aptitudeDB

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRE=7d

# ─── Client URL (for email verification links) ────────────────
CLIENT_URL=http://localhost:5173
# Optional: CORS ke liye comma-separated frontend URLs (na ho to CLIENT_URL use hota hai)
# CORS_ORIGINS=https://my-project.web.app,https://my-project.firebaseapp.com

# Optional: per-IP requests per 15 min (production default 200)
# RATE_LIMIT_MAX=500

# ─── SMTP Email Configuration (Gmail) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="ApptitudeTest.live" <your-email@gmail.com>

# ─── Brevo API (production / Render) ──────────────────────────
# Render free tier SMTP ports block karta hai — wahan ye zaroori hai.
# Set ho to SMTP ki jagah Brevo HTTP API use hota hai. EMAIL_FROM ka email Brevo me verified sender hona chahiye.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# ─── AI (Gemini) ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.25
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=4096

# ─── Cloudinary (Image Storage) ───────────────────────────────
# Optional locally (falls back to filesystem).
# Required in production for persistent image storage.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
